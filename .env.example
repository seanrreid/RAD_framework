# RAD environment — copy to .env and fill in as needed.
#
# NOTE: RAD does not auto-load .env (no dotenv). These are read from the
# process environment, so export them into your shell, e.g.:
#   set -a; source .env; set +a       # or use direnv
#
# Every variable below is OPTIONAL. With none set, RAD runs the command
# agent adapter and needs no API key.

# ── Agent adapter (rad deliver) ───────────────────────────────────────────────
# Which agent drives wave execution. Default: command.
#   command — spawns the CLI in RAD_AGENT_CMD (no ANTHROPIC_API_KEY needed)
#   sdk     — drives the Claude Agent SDK (requires ANTHROPIC_API_KEY + an
#             explicit `npm install` in harness/ to pull the optional SDK)
# RAD_AGENT=command

# The CLI to spawn when RAD_AGENT=command (e.g. "claude -p", "codex exec", "aider").
# RAD_AGENT_CMD=claude -p

# Required ONLY when RAD_AGENT=sdk. Never commit a real key — .env is git-ignored.
# ANTHROPIC_API_KEY=sk-ant-...

# ── Cost & frugality (optional) ───────────────────────────────────────────────
# Per-deliver cumulative output-token ceiling; deliver stops gracefully at the cap.
# RAD_TOKEN_BUDGET=500000

# ── Worktree isolation (optional) ─────────────────────────────────────────────
# Any non-empty value opts a deliver run into git-worktree isolation.
# RAD_WORKTREE=1
# Base directory for the isolated worktree.
# RAD_WORKTREE_DIR=../rad-worktrees

# ── Portable process memory — sync (optional) ─────────────────────────────────
# Any non-empty/truthy value folds plain-git push-on-write and fetch-tip-on-read
# into the rad verbs, so the canonical event log / plan doc follow you between
# machines. Plain-git ONLY (git push / git fetch) — never gh/glab. Inherits your
# existing git credentials; never prompts for or stores any. Offline-fail-safe:
# the local commit ALWAYS lands and the push is best-effort (a failed push never
# blocks the verb). Unset = today's behavior, byte-for-byte.
# RAD_SYNC=1

# ── Wave-lifecycle hooks (optional) ───────────────────────────────────────────
# Directory of operator hook scripts. Default: scripts/hooks
# RAD_HOOKS_DIR=scripts/hooks

# ── Branch & lint conventions (optional) ──────────────────────────────────────
# Work-branch prefix. Default: rad/
# RAD_BRANCH_PREFIX=rad/
# Pipe-separated extended-regex of high-risk paths the plan lint flags (advisory).
# Default: auth|payment|billing|migration|secret|credential|token
# RAD_HIGH_RISK_PATTERNS=auth|payment|billing|migration|secret|credential|token

# ── Severity routing — low-risk allowlist (optional) ──────────────────────────
# Pipe-separated extended-regex of paths scripts/classify-low-risk.sh may auto-clear.
# A plan is "low" (auto-clearable) iff every touched path matches this AND none
# match RAD_HIGH_RISK_PATTERNS (high-risk wins ties) AND scope is unchanged.
# Empty/unset = OFF (every plan takes the human-approval path). Fail-closed.
# The default is inert-by-type only (stylesheets, image/font assets, docs);
# tests, config, lockfiles, and CI are EXCLUDED — keep any override tight.
# Default: css|scss|\.(png|jpe?g|gif|svg|webp|woff2?|ttf|otf|eot)$|\.md$|^docs/
# RAD_LOW_RISK_PATTERNS=css|scss|\.(png|jpe?g|gif|svg|webp|woff2?|ttf|otf|eot)$|\.md$|^docs/

# ── Self-protected paths (built-in, NOT configurable) ─────────────────────────
# A built-in set covering RAD's own machinery (harness/, scripts/, .claude/,
# .agents/state/, gates.yaml, matrix.yaml) is ALWAYS high-risk and never
# auto-clearable — it wins over any RAD_LOW_RISK_PATTERNS, including .*.
# It intentionally has NO env var (non-configurable by design; see CLAUDE.md
# "Self-Protected Paths"). Listed here for transparency only.

# ── CI integrity checks (optional) ────────────────────────────────────────────
# Overrides the CLAUDE.md architect identity for the authenticity check in
# scripts/check-approval-integrity.sh (the approval commit's git author email
# must match the configured architect). Set it in CI or on machines whose git
# identity differs from the CLAUDE.md Role Assignments entry. When set, it wins
# over CLAUDE.md. Unset = today's behavior (parse the architect from CLAUDE.md).
# RAD_ARCHITECT_OVERRIDE=sean@torchcodelab.com

# ── Findings loop (optional) ──────────────────────────────────────────────────
# Recurrence threshold for /rad-insights' Findings Recurrence step: categories
# with at least this many findings in .agents/findings.jsonl get a suggested
# CLAUDE.md convention bullet or described lint rule (suggestion only — applied
# via PR, never auto-applied). Parsed with Number.parseInt; unset, 0, NaN, or
# negative all fall back to the default 5.
# RAD_FINDINGS_THRESHOLD=5
